PROJECT_NAME           = "Unix Systems Programming Examples"
PROJECT_BRIEF          = "Examples of POSIX processes and FIFO communication"
OUTPUT_DIRECTORY       = .
INPUT                  = src README.md
FILE_PATTERNS          = *.c *.h *.md
RECURSIVE              = NO
USE_MDFILE_AS_MAINPAGE = README.md

OPTIMIZE_OUTPUT_FOR_C  = YES
EXTRACT_ALL            = YES
EXTRACT_STATIC         = YES
SOURCE_BROWSER         = YES
INLINE_SOURCES         = NO

GENERATE_HTML          = YES
HTML_OUTPUT            = html
GENERATE_LATEX         = YES
LATEX_OUTPUT           = latex

QUIET                  = YES
WARN_IF_UNDOCUMENTED   = NO
WARN_IF_DOC_ERROR      = YES
HAVE_DOT               = NO
